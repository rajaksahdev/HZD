# Copy to .env and fill in. Commit this file; never commit .env.
POSTGRES_USER=hazard
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hazardlens
# Host port for the database container. 5433 avoids clashing with a local PostgreSQL on 5432.
DB_PORT=5433
REDIS_PORT=6379
DATABASE_URL=postgresql+psycopg://hazard:change_me@localhost:5433/hazardlens
REDIS_URL=redis://localhost:6379/0

# Pilot box (Mumbai): min_lon,min_lat,max_lon,max_lat
PILOT_BBOX=72.70,18.85,73.10,19.35

EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
CDSAPI_KEY=
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
GSMAP_USERNAME=
GSMAP_PASSWORD=
TELEGRAM_BOT_TOKEN=
ALERT_SIGNING_KEY_PATH=./secrets/alert_key.pem
